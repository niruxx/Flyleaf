# Copy to .env and adjust. All settings are optional.

# Port and interface to listen on. 0.0.0.0 makes Flyleaf reachable from your LAN
# (and from the internet if you port-forward this port on your router).
PORT=7878
HOST=0.0.0.0

# Where the database, covers and caches are stored.
FLYLEAF_DATA_DIR=./data

# Optional parent directories where guests may move their personal folders.
# Use absolute server paths separated by ; on Windows or : on Linux.
# FLYLEAF_USER_STORAGE_ROOTS=/mnt/ssd/flyleaf-users

# Rescan libraries for new files every N minutes (0 = only on start / manual).
SCAN_INTERVAL_MINUTES=60

# Optional import inbox. Use an existing folder separate from every library.
BOOKDROP_DIR=
BOOKDROP_ONLINE_METADATA=true

# How long sign-ins last, in days.
SESSION_DAYS=30

# Set both to true when Flyleaf sits behind an HTTPS reverse proxy
# (Caddy, nginx, Cloudflare Tunnel, Tailscale Funnel...).
TRUST_PROXY=false
SECURE_COOKIES=false

# Optional OpenID Connect login. Use an HTTPS issuer and Flyleaf's HTTPS public origin.
# Register https://<your-flyleaf-host>/api/oidc/callback with the provider.
OIDC_ISSUER=
OIDC_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# New OIDC identities become guests. Set false to require linking an existing account.
OIDC_ALLOW_SIGNUP=true
# Set all to grant new OIDC guests access to all shared libraries.
OIDC_SHARED_LIBRARIES=none

# Optional DeepL API key for reader translations. Both API Free and Pro are supported.
# Keep the key on the server. Leave it blank to use MyMemory.
DEEPL_AUTH_KEY=

# Terminal log verbosity: debug, info, warn, error. Full details always go to data/logs/flyleaf.log.
LOG_LEVEL=info
# Largest file the Upload page accepts, in MB.
MAX_UPLOAD_MB=4096

# Tracking connections (Settings -> Account). See docs/tracking.md.
# Canonical external origin; use HTTPS, or http://localhost:7878 for development.
TRACKING_BASE_URL=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Kitsu and MangaUpdates use account sign-in and need no application keys.
