{
  "name": "flyleaf",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted library and reader for ebooks, manga and comics with a Material 3 web UI, OPDS and metadata scraping",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "icons": "node scripts/make-icons.js",
    "reset-password": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/reset-password.js",
    "i18n": "node scripts/i18n.js"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "7zip-bin": "^5.2.0",
    "archiver": "^8.0.0",
    "express": "^5.3.0",
    "foliate-js": "github:johnfactotum/foliate-js#78914aef4466eb960965702401634c2cb348e9b1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "material-symbols": "^0.48.0",
    "node-html-parser": "^9.0.4",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^10.1.4",
    "pdfjs-dist": "^6.4.299",
    "tar": "^7.5.22",
    "wasmoon": "^1.16.0",
    "yauzl": "^3.4.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
