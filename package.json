{
  "name": "flyleaf",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted ebook, manga and comic reader with a Material 3 web UI",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "icons": "node scripts/make-icons.js",
    "reset-password": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/reset-password.js"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "epubjs": "^0.3.93",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "material-symbols": "^0.48.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "yauzl": "^3.4.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
